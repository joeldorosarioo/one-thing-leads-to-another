{
  "name": "note-template-sync",
  "version": "0.5.0",
  "private": true,
  "description": "Visual data editor and portable Markdown template generation for Obsidian",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json \u0026\u0026 tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run",
    "test": "npm run test:unit",
    "check": "npm run typecheck \u0026\u0026 npm run test:unit \u0026\u0026 npm run lint \u0026\u0026 npm run format:check",
    "lint": "eslint src tests *.cjs *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "obsidian": "latest",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typescript-eslint": "^8.59.0",
    "@eslint/js": "^9.39.0"
  }
}
