{
  "name": "note-template-sync",
  "version": "0.5.4",
  "private": true,
  "description": "Visual data editor and portable Markdown template generation for Obsidian",
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node scripts/build-bundle.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test:regression": "npm run build && node --test tests/*.test.js",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:regression",
    "check": "npm run typecheck && npm run build && npm run test:unit && node --test tests/*.test.js && node --check main.js && npm run lint && npm run format:check",
    "lint": "eslint src tests scripts *.cjs *.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^3.2.0"
  }
}
